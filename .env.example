# Discord bot token from https://discord.com/developers/applications
# (Bot tab -> Reset Token). This is the only value you need to fill in.
DISCORD_TOKEN=replace-with-your-bot-token

# SQLite database location. The default works for both local dev and Docker
# (data/ is created automatically and is bind-mounted into the container).
DATABASE_URL=sqlite:///./data/shadowdark.db

# --- Web character sheet / Discord Activity (optional) ---
# Leave WEB_ENABLED=false to run the bot only. When true, every value below
# must be set or the bot refuses to start. See docs/implementation/discord-activity.md.
WEB_ENABLED=false
WEB_PORT=8080
PUBLIC_BASE_URL=https://shadowdark.bunnyufo.net
# Developer Portal -> OAuth2 for this same application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Comma-separated server IDs; only their members can log in.
ALLOWED_GUILD_IDS=
# The reverse proxy's IP (Nginx Proxy Manager), trusted for X-Forwarded-* headers.
FORWARDED_ALLOW_IPS=192.168.1.11
